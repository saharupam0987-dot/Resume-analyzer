# =============================================================================
# EVAL_APP PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
#
# Duplicate this file as '.env' before running Docker Compose:
#   copy .env.example .env     (Windows CMD)
#   cp .env.example .env       (Linux / Mac / PowerShell)
#
# Replace placeholders with your actual production secrets.
# NEVER commit the actual '.env' file to source control.
# =============================================================================

# --- PostgreSQL Relational Database ---
POSTGRES_DB=eval_app_prod
POSTGRES_USER=eval_user
POSTGRES_PASSWORD=your_super_secret_postgres_password_here

# DATABASE_URL used by FastAPI and Celery Worker inside Docker
# Format: postgresql://<user>:<password>@postgresql:5432/<dbname>
DATABASE_URL=postgresql://eval_user:your_super_secret_postgres_password_here@postgresql:5432/eval_app_prod

# --- Redis Broker & Cache ---
# Points to the 'redis' container service inside Docker's internal bridge network
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# --- LLM / AI Configuration ---
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend API Base URL ---
# In production behind Nginx reverse proxy, leave empty ("") so requests use same-origin relative URLs.
# For local dev without Docker Compose, this can be set to http://localhost:8000
VITE_API_URL=

# --- File Storage Directory ---
STORAGE_DIR=/app/uploads

# --- External Public Port ---
PORT=80
